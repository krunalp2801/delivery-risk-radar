# With none of this set, `npm run demo` runs against a bundled snapshot of a
# fictional project and needs no network.

# --- GitHub ------------------------------------------------------------------
# A classic or fine-grained token with read access to issues. Public repos work
# without one, at a much lower rate limit.
# GITHUB_TOKEN=
# GITHUB_REPO=owner/name
# GITHUB_API_URL=https://api.github.com

# --- Jira --------------------------------------------------------------------
# JIRA_BASE_URL=https://your-org.atlassian.net
# JIRA_EMAIL=you@example.com
# JIRA_API_TOKEN=
# JIRA_JQL=project = PROJ AND statusCategory != Done

# --- Optional narrative ------------------------------------------------------
# Writes the two-paragraph summary at the top of the report. It is given the
# computed numbers and told not to introduce any; every number in the report
# comes from the deterministic pass either way.
# ANTHROPIC_API_KEY=
# RADAR_NARRATIVE_MODEL=claude-haiku-4-5-20251001

# --- Thresholds --------------------------------------------------------------
# RADAR_STALE_DAYS=7
# RADAR_THROUGHPUT_WEEKS=4
